  "components": {
    "schemas": {
      "AnalysisResponse": {
        "properties": {
          "original_prompt": {
            "type": "string",
            "title": "Original Prompt"
          },
          "improved_prompt": {
            "type": "string",
            "title": "Improved Prompt"
          },
          "promptfoo_report": {
            "additionalProperties": true,
            "type": "object",
            "title": "Promptfoo Report"
          }
        },
        "type": "object",
        "required": [
          "original_prompt",
          "improved_prompt",
          "promptfoo_report"
        ],
        "title": "AnalysisResponse"
      },
      "ErrorReport": {
        "properties": {
          "service_name": {
            "type": "string",
            "title": "Service Name"
          },
          "error_message": {
            "type": "string",
            "title": "Error Message"
          },
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "service_name",
          "error_message"
        ],
        "title": "ErrorReport"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaginatedPromptsResponse": {
        "properties": {
          "prompts": {
            "items": {
              "$ref": "#/components/schemas/Prompt"
            },
            "type": "array",
            "title": "Prompts"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "skip": {
            "type": "integer",
            "title": "Skip"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          }
        },
        "type": "object",
        "required": [
          "prompts",
          "total",
          "skip",
          "limit"
        ],
        "title": "PaginatedPromptsResponse"
      },
      "Prompt": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "value",
          "key"
        ],
        "title": "Prompt"
      },
      "PromptCreate": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value"
          },
          "key": {
            "type": "string",
            "title": "Key"
          }
        },
        "type": "object",
        "required": [
          "value",
          "key"
        ],
        "title": "PromptCreate"
      },
      "PromptUpdate": {
        "properties": {
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "value"
        ],
        "title": "PromptUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
