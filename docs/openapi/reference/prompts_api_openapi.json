    "/": {
      "get": {
        "tags": [
          "prompts"
        ],
        "summary": "List Prompts",
        "description": "Liste tous les prompts avec pagination. R\u00e9serv\u00e9 aux admins.",
        "operationId": "list_prompts__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Nombre d'enregistrements \u00e0 sauter",
              "default": 0,
              "title": "Skip"
            },
            "description": "Nombre d'enregistrements \u00e0 sauter"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Nombre max d'enregistrements retourn\u00e9s",
              "default": 50,
              "title": "Limit"
            },
            "description": "Nombre max d'enregistrements retourn\u00e9s"
