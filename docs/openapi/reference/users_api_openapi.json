  "components": {
    "schemas": {
      "BulkUsersRequest": {
        "properties": {
          "user_ids": {
            "items": {
              "type": "integer",
              "maximum": 2147483647.0,
              "exclusiveMinimum": 0.0
            },
            "type": "array",
            "title": "User Ids",
            "description": "Liste d'IDs utilisateurs (INT4). Les IDs hors plage [1, 2147483647] sont rejet\u00e9s."
          }
        },
        "type": "object",
        "required": [
          "user_ids"
        ],
        "title": "BulkUsersRequest",
        "description": "Corps de la requ\u00eate POST /bulk \u2014 liste d'IDs utilisateurs valid\u00e9s INT4."
      },
      "DuplicateCandidate": {
        "properties": {
          "users": {
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            },
            "type": "array",
            "title": "Users"
          }
        },
        "type": "object",
        "required": [
          "users"
        ],
        "title": "DuplicateCandidate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "pattern": "^[^\\x00]*$",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MergeRequest": {
        "properties": {
          "source_id": {
            "type": "integer",
            "maximum": 2147483647.0,
            "exclusiveMinimum": 0.0,
            "title": "Source Id",
            "description": "ID de l'utilisateur source (INT4)"
          },
          "target_id": {
            "type": "integer",
            "maximum": 2147483647.0,
            "exclusiveMinimum": 0.0,
            "title": "Target Id",
            "description": "ID de l'utilisateur cible (INT4)"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "target_id"
        ],
        "title": "MergeRequest"
      },
      "ServiceAccountLoginRequest": {
        "properties": {
          "id_token": {
            "type": "string",
            "title": "Id Token"
          }
        },
        "type": "object",
        "required": [
          "id_token"
        ],
        "title": "ServiceAccountLoginRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "TokenResponse",
        "description": "Token representation needed by consumers to avoid silent JSON parsings."
      },
      "UserCreate": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "rh",
              "commercial",
              "admin",
              "service_account"
            ],
            "title": "Role",
            "default": "user"
          },
          "seniority": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seniority"
          },
          "allowed_category_ids": {
            "items": {
              "type": "integer",
              "maximum": 2147483647.0,
              "exclusiveMinimum": 0.0
            },
            "type": "array",
            "title": "Allowed Category Ids",
            "default": []
          },
          "picture_url": {
